# Server Configuration
PORT=8000
NODE_ENV=production

# Database & Cache Connection Strings
MONGO_DB_URL=mongodb+srv://<db_user>:<db_password>@cluster0.hhg9bhg.mongodb.net/nexus_game_db?retryWrites=true&w=majority
REDIS_URI=rediss://default:<redis_password>@<redis_host>:6379

# Cryptographic Token Secrets (Use strong random hex strings)
JWT_SECRET=super_secret_matchmaker_jwt_key_2026
ACCESS_TOKEN_SECRET=super_secret_matchmaker_access_token_key_2026
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=super_secret_matchmaker_refresh_token_key_2026
REFRESH_TOKEN_EXPIRY=10d

# Security - Allowed Frontend Origins for CORS (Set exact origin in production)
CORS_ORIGIN=https://your-frontend-app.vercel.app

# Email Setup (Brevo / Resend / Nodemailer SMTP)
# Option A: Brevo HTTPS API Key (Recommended for Render/AWS deployment to avoid SMTP port blocks)
BREVO_API_KEY=xkeysib-your-brevo-api-key

# Option B: Standard SMTP (Brevo SMTP: host=smtp-relay.brevo.com, port=587)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_account_email@domain.com
SMTP_PASS=your_brevo_smtp_key
EMAIL_FROM="Nexus Arena" <your_verified_sender@domain.com>

# Cloudinary Setup (Avatar & Cover Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
